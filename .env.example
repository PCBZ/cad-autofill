# Copy to .env and fill in. .env is ignored by git; never commit it.

# One OpenRouter key for the crews (via CrewAI + LiteLLM) and for Jev.
OPENROUTER_API_KEY=

# Keep CrewAI from sending telemetry or traces. Traces can contain shipment text.
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false
