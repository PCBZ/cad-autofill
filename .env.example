# Copy to .env and fill in. .env is ignored by git; never commit it.

# One OpenRouter key for the crews (via CrewAI + LiteLLM) and for Jev.
OPENROUTER_API_KEY=

# Keep CrewAI from sending telemetry or traces (traces can contain shipment text) and from
# checking pypi.org for a new version on every run.
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_VERSION_CHECK=true
